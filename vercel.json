{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/en", "destination": "/en.html" },
    { "source": "/backtest", "destination": "/backtest.html" },
    { "source": "/market-sentiment", "destination": "/market-sentiment.html" },
    { "source": "/hk-factor-lab", "destination": "/hk-factor-lab.html" }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{.runtime/**,.venv/**,.venv-qlib/**,hk-factor-site/**,xtquant/**,ml/**,tests/**,outputs/**,**/__pycache__/**,**/*.pyc,**/*.pyd,**/*.dll,**/*.pdf,**/*.ipynb}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
