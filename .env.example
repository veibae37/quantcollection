APP_NAME=A 股量化选股看板
APP_SUBTITLE=从沪深 A 股可交易池生成可解释的多因子候选组合
APP_PUBLIC_NOTICE=选股结果仅用于研究展示，不构成投资建议，也不会触发真实交易。
ALLOW_DEMO_EXECUTION=true
MAX_INPUT_BYTES=16384
NATIONAL_TEAM_ETFS=510300.SH,510050.SH
REGIME_ABS_FLOW_THRESHOLD_CNY=5000000000
REGIME_FLOW_RATIO_BPS_THRESHOLD=20
REGIME_ZSCORE_THRESHOLD=2.0
AKSHARE_RETRY_ATTEMPTS=3
AKSHARE_RETRY_BACKOFF_SECONDS=1
A_SHARE_CACHE_SECONDS=300
A_SHARE_ALLOW_SYNTHETIC_FALLBACK=true
A_SHARE_HTTP_TIMEOUT_SECONDS=8
OPTION_CACHE_SECONDS=180
OPTION_ALLOW_SYNTHETIC_FALLBACK=true
OPTION_HTTP_TIMEOUT_SECONDS=8
