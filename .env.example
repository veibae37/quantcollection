# Public website text.  Market-data programs are always live-QMT-only.
APP_NAME=A 股量化选股看板
MAX_INPUT_BYTES=16384
ALLOW_DEMO_EXECUTION=false
A_SHARE_ALLOW_SYNTHETIC_FALLBACK=false
OPTION_ALLOW_SYNTHETIC_FALLBACK=false

# Local Windows MiniQMT publisher.  Never configure the terminal path in Vercel.
MINI_QMT_PATH=C:\path\to\userdata_mini
MINIQMT_PATH=C:\path\to\userdata_mini
MINIQMT_SESSION_ID=952701
QMT_WEBHOOK_URL=https://quantcollection-aa5n.vercel.app/api/live
QMT_WEBHOOK_SECRET=replace_with_at_least_24_random_characters
QMT_SECRET_HEADER=X-QMT-Secret
QMT_PUBLISH_INTERVAL=60
QMT_HTTP_TIMEOUT=20
QMT_DISPLAY_TOTAL_ASSET=1000000
QMT_FLOW_ETFS=510300.SH,510050.SH,159919.SZ

# QMT ETF option scanner settings used by the unified publisher.
OPTIONS_INTEREST_RATE=0.03
OPTIONS_MIN_NET_CNY=0
OPTIONS_TOP_N=50
OPTIONS_MIN_DEPTH=1
OPTIONS_UNIVERSE_REFRESH=300

# Vercel project only.  QMT_WEBHOOK_SECRET must match the local value.
# BLOB_READ_WRITE_TOKEN is generated by the connected private Blob store.
QMT_SNAPSHOT_STALE_SECONDS=900
QMT_MAX_UPLOAD_BYTES=2097152

# Real order switches remain disabled; the publisher never uses them.
MINIQMT_ENABLE_LIVE_TRADING=disabled
MINIQMT_ENABLE_QMT_SELECTION_LIVE=disabled
